# Required
ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — enables semantic news↔risk matching via OpenAI text-embedding-3-small.
# Without it, pull_sources falls back to keyword-only matching (current default).
# Pair with applying supabase/migrations/007-news-cache-embedding.sql.
OPENAI_API_KEY=

# castle-scraper — separate Supabase project (read-only consumer)
SCRAPER_SUPABASE_URL=
SCRAPER_SUPABASE_SERVICE_ROLE_KEY=
LIBRARY_SUPABASE_URL=
LIBRARY_SUPABASE_SERVICE_ROLE_KEY=

# Phase-2 source adapters
# SEC EDGAR requires "Name email@domain" — empty means the adapter no-ops.
SEC_USER_AGENT=
# Optional — lifts CourtListener free-tier rate limit. Empty = anonymous OK.
COURT_LISTENER_TOKEN=

# Cron / internal
CRON_SECRET=
REVALIDATE_TOKEN=

# Admin auth — comma-separated email allowlist
ADMIN_EMAILS=

# Optional
SLACK_WEBHOOK_URL=
SENTRY_DSN=

# Render-injected at runtime; for local dev set to http://localhost:3000
WEB_URL=http://localhost:3000
